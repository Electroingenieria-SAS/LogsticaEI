rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function userPath() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }

    function userExists() {
      return signedIn() && exists(userPath());
    }

    function userDoc() {
      return get(userPath()).data;
    }

    function role() {
      return userDoc().role;
    }

    function activeUser() {
      return userExists() && userDoc().isActive == true;
    }

    function isAdmin() {
      return activeUser() && role() in ['admin', 'super_admin'];
    }

    function isManager() {
      return activeUser() && role() == 'gerencia';
    }

    function isChiefLogistics() {
      return activeUser() && role() == 'jefe_logistica';
    }

    function canSeeAll() {
      return isAdmin() || isManager() || isChiefLogistics();
    }

    function canManageUsers() {
      return isAdmin() || isManager();
    }

    function validRoleValue(value) {
      return value in [
        'admin',
        'super_admin',
        'gerencia',
        'ventas',
        'jefe_logistica',
        'lider_logistico',
        'coordinador_logistico',
        'aux_logistica',
        'auxiliar_corte',
        'caja',
        'inventarios',
        'auditoria'
      ];
    }

    function validUserPayload() {
      return request.resource.data.keys().hasOnly([
        'name',
        'email',
        'role',
        'isActive',
        'createdAt',
        'createdBy',
        'updatedAt',
        'updatedBy'
      ])
      && request.resource.data.name is string
      && request.resource.data.email is string
      && request.resource.data.role is string
      && request.resource.data.isActive is bool
      && validRoleValue(request.resource.data.role);
    }

    function validCasePayload() {
      return request.resource.data.keys().hasAny([
        'currentProcess',
        'assignedRole',
        'status',
        'createdAt',
        'updatedAt'
      ]);
    }

    function isOwnCase() {
      return resource.data.createdBy == request.auth.uid;
    }

    function isAssignedRoleCase() {
      return resource.data.assignedRole == role();
    }

    function isAssignedUidCase() {
      return resource.data.assignedUid == request.auth.uid || resource.data.assignedTo == request.auth.uid;
    }

    function isCutCase() {
      return role() == 'auxiliar_corte' && resource.data.hasCuts == true;
    }

    function canReadCase() {
      return activeUser() && (
        canSeeAll() ||
        isOwnCase() ||
        isAssignedRoleCase() ||
        isAssignedUidCase() ||
        isCutCase()
      );
    }

    function canOperateCase() {
      return activeUser() && (
        canSeeAll() ||
        isAssignedRoleCase() ||
        isAssignedUidCase() ||
        isCutCase()
      );
    }

    match /users/{userId} {
      allow read: if activeUser() && (
        request.auth.uid == userId ||
        canSeeAll() ||
        canManageUsers()
      );

      allow create: if canManageUsers()
        && validUserPayload();

      allow update: if canManageUsers()
        && validUserPayload();

      allow delete: if isAdmin();
    }

    match /cases/{caseId} {
      allow read: if canReadCase();

      allow create: if activeUser()
        && validCasePayload();

      allow update: if canOperateCase()
        && validCasePayload();

      allow delete: if isAdmin();
    }

    match /case_events/{eventId} {
      allow read: if activeUser() && (
        canSeeAll() ||
        resource.data.userId == request.auth.uid ||
        resource.data.createdBy == request.auth.uid
      );

      allow create: if activeUser();

      allow update, delete: if false;
    }

    match /requirements/{requirementId} {
      allow read: if activeUser() && (
        canSeeAll() ||
        resource.data.targetRole == role() ||
        resource.data.sourceRole == role() ||
        resource.data.createdBy == request.auth.uid
      );

      allow create: if activeUser()
        && request.resource.data.targetRole == 'ventas'
        && request.resource.data.sourceProcess == 'corte_cable';

      allow update: if activeUser() && (
        canSeeAll() ||
        resource.data.targetRole == role()
      );

      allow delete: if isAdmin();
    }

    match /evidences/{evidenceId} {
      allow read: if activeUser() && (
        canSeeAll() ||
        resource.data.createdBy == request.auth.uid ||
        resource.data.responsibleRole == role()
      );

      allow create: if activeUser();
      allow update: if false;
      allow delete: if isAdmin();
    }

    match /kpis/{kpiId} {
      allow read: if canSeeAll();
      allow create, update, delete: if isAdmin();
    }

    match /system_config/{configId} {
      allow read: if canSeeAll();
      allow create, update, delete: if isAdmin();
    }
  }
}
