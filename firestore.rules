rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function userPath() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }

    function userExists() {
      return signedIn() && exists(userPath());
    }

    function userDoc() {
      return get(userPath()).data;
    }

    function role() {
      return userDoc().role;
    }

    function activeUser() {
      return userExists() && userDoc().isActive == true;
    }

    function isAdmin() {
      return activeUser() && role() in ['admin', 'administrador', 'Admin', 'Administrador', 'ADMIN'];
    }

    function isSuperAdmin() {
      return activeUser() && role() in ['super_admin', 'super_administrador', 'super admin', 'superadmin', 'super-administrador', 'Super Admin', 'Super administrador', 'Super Administrador', 'SUPER_ADMIN', 'SUPER ADMIN', 'super administrador', 'super_administracion', 'superadministrador', 'super_administrador'];
    }

    function isAdminOrSuper() {
      return isAdmin() || isSuperAdmin();
    }

    function isManager() {
      return activeUser() && role() == 'gerencia';
    }

    function isChiefLogistics() {
      return activeUser() && role() == 'jefe_logistica';
    }

    function isReceptionLeader() {
      return activeUser() && role() == 'lider_recepcion';
    }

    function isProjectsRole() {
      return activeUser() && role() == 'proyectos';
    }

    function canManageReports() {
      return isAdminOrSuper() || isManager() || isChiefLogistics();
    }

    function isUnifiedLogisticsRole(value) {
      return value in ['lider_logistico', 'coordinador_logistico'];
    }

    function sameOperationalRole(a, b) {
      return a == b || (isUnifiedLogisticsRole(a) && isUnifiedLogisticsRole(b));
    }

    function canSeeAll() {
      return isAdminOrSuper() || isManager() || isChiefLogistics();
    }

    function canManageUsers() {
      return isAdminOrSuper() || isManager();
    }

    function validRoleValue(value) {
      return value in [
        'admin',
        'super_admin',
        'super_administrador',
        'super admin',
        'superadmin',
        'super-administrador',
        'Super Admin',
        'Super administrador',
        'Super Administrador',
        'SUPER_ADMIN',
        'SUPER ADMIN',
        'super administrador',
        'super_administracion',
        'administrador',
        'gerencia',
        'ventas',
        'proyectos',
        'proyecto',
        'rol_proyectos',
        'jefe_logistica',
        'lider_logistico',
        'coordinador_logistico',
        'aux_logistica',
        'auxiliar_corte',
        'caja',
        'inventarios',
        'lider_recepcion',
        'auditoria'
      ];
    }

    function validUserPayload() {
      return request.resource.data.name is string
      && request.resource.data.email is string
      && request.resource.data.role is string
      && request.resource.data.isActive is bool
      && validRoleValue(request.resource.data.role);
    }

    function validCasePayload() {
      return request.resource.data.keys().hasAny([
        'currentProcess',
        'assignedRole',
        'status',
        'createdAt',
        'updatedAt'
      ]);
    }

    function validReceptionPayload() {
      return request.resource.data.keys().hasAny([
        'documentNumber',
        'supplier',
        'receiptType',
        'conformity',
        'status',
        'support',
        'closureEvidence',
        'finalDecisionStatus',
        'createdAt',
        'updatedAt'
      ]);
    }

    function validReportPayload() {
      return request.resource.data.keys().hasAny([
        'title',
        'category',
        'sourceModule',
        'sourceId',
        'sourceReference',
        'status',
        'severity',
        'description',
        'detail',
        'createdAt',
        'updatedAt'
      ]);
    }

    function isOwnCase() {
      return resource.data.createdBy == request.auth.uid;
    }

    function isAssignedRoleCase() {
      return sameOperationalRole(resource.data.assignedRole, role());
    }

    function isAssignedUidCase() {
      return resource.data.assignedUid == request.auth.uid || resource.data.assignedTo == request.auth.uid;
    }

    function isCutCase() {
      return role() == 'auxiliar_corte' && resource.data.hasCuts == true;
    }

    function canReadCase() {
      return activeUser() && (
        canSeeAll() ||
        isOwnCase() ||
        isAssignedRoleCase() ||
        isAssignedUidCase() ||
        isCutCase()
      );
    }

    function canOperateCase() {
      return activeUser() && (
        canSeeAll() ||
        isAssignedRoleCase() ||
        isAssignedUidCase() ||
        isCutCase()
      );
    }

    match /users/{userId} {
      allow read: if activeUser() && (
        request.auth.uid == userId ||
        canSeeAll() ||
        canManageUsers()
      );

      allow create: if canManageUsers()
        && validUserPayload();

      allow update: if canManageUsers()
        && validUserPayload();

      allow delete: if isAdminOrSuper();
    }

    match /cases/{caseId} {
      allow read: if canReadCase();
      allow create: if activeUser() && validCasePayload();
      allow update: if canOperateCase() && validCasePayload();
      allow delete: if isAdminOrSuper();
    }

    match /case_events/{eventId} {
      allow read: if activeUser() && (
        canSeeAll() ||
        resource.data.userId == request.auth.uid ||
        resource.data.createdBy == request.auth.uid ||
        resource.data.assignedTo == request.auth.uid ||
        resource.data.assignedUid == request.auth.uid ||
        sameOperationalRole(resource.data.targetRole, role()) ||
        sameOperationalRole(resource.data.assignedRole, role()) ||
        sameOperationalRole(resource.data.sourceRole, role()) ||
        sameOperationalRole(resource.data.role, role()) ||
        (resource.data.visibleRoles is list && role() in resource.data.visibleRoles)
      );

      allow create: if activeUser();
      allow update: if false;
      allow delete: if isAdminOrSuper();
    }

    match /requirements/{requirementId} {
      allow read: if activeUser() && (
        canSeeAll() ||
        sameOperationalRole(resource.data.targetRole, role()) ||
        sameOperationalRole(resource.data.sourceRole, role()) ||
        resource.data.createdBy == request.auth.uid
      );

      allow create: if activeUser() && (
        canSeeAll() ||
        (
          request.resource.data.targetRole == 'ventas'
          && request.resource.data.sourceProcess == 'corte_cable'
        ) ||
        (
          request.resource.data.targetRole == 'proyectos'
          && request.resource.data.sourceProcess == 'proyectos'
        )
      );

      allow update: if activeUser() && (
        canSeeAll() ||
        sameOperationalRole(resource.data.targetRole, role())
      );

      allow delete: if isAdminOrSuper();
    }

    match /evidences/{evidenceId} {
      allow read: if activeUser() && (
        canSeeAll() ||
        resource.data.createdBy == request.auth.uid ||
        sameOperationalRole(resource.data.responsibleRole, role())
      );

      allow create: if activeUser();
      allow update: if false;
      allow delete: if isAdminOrSuper();
    }

    match /kpis/{kpiId} {
      allow read: if canSeeAll();
      allow create, update, delete: if isAdminOrSuper();
    }

    match /siesa_exports/{exportId} {
      allow read: if canSeeAll() || (activeUser() && role() == 'auxiliar_corte');
      allow create: if canSeeAll() || (activeUser() && role() == 'auxiliar_corte');
      allow update, delete: if isAdminOrSuper();
    }

    match /proyectos_pedidos/{projectId} {
      allow read: if activeUser() && (
        isAdminOrSuper() ||
        isProjectsRole() ||
        resource.data.createdBy == request.auth.uid
      );

      allow create: if activeUser() && (
        isAdminOrSuper() ||
        isProjectsRole()
      );

      allow update: if activeUser() && (
        isAdminOrSuper() ||
        isProjectsRole()
      );

      allow delete: if isAdminOrSuper();
    }

    match /recepciones_mercancia/{receptionId} {
      allow read: if activeUser() && (isAdminOrSuper() || isReceptionLeader());
      allow create: if activeUser() && (isAdminOrSuper() || isReceptionLeader()) && validReceptionPayload();
      allow update: if activeUser() && (isAdminOrSuper() || isReceptionLeader()) && validReceptionPayload();
      allow delete: if isSuperAdmin();
    }

    match /reportes_novedad/{reportId} {
      allow read: if activeUser();
      allow create: if activeUser() && validReportPayload();
      allow update: if activeUser() && (canManageReports() || isReceptionLeader()) && validReportPayload();
      allow delete: if isSuperAdmin();
    }

    match /users_deleted_log/{logId} {
      allow read, create: if isAdminOrSuper();
      allow update, delete: if false;
    }

    match /system_config/{configId} {
      allow read: if canSeeAll();
      allow create, update, delete: if isAdminOrSuper();
    }

    match /{document=**} {
      allow delete: if isAdminOrSuper();
    }
  }
}
