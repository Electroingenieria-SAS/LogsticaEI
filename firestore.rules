rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function userPath() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }

    function userExists() {
      return signedIn() && exists(userPath());
    }

    function userDoc() {
      return get(userPath()).data;
    }

    function role() {
      return userDoc().role;
    }

    function activeUser() {
      return userExists() && userDoc().isActive == true;
    }

    function isAdmin() {
      return activeUser() && role() in ['admin', 'administrador', 'Admin', 'Administrador', 'ADMIN'];
    }

    function isSuperAdmin() {
      return activeUser() && role() in [
        'super_admin',
        'super_administrador',
        'super admin',
        'superadmin',
        'super-administrador',
        'Super Admin',
        'Super administrador',
        'Super Administrador',
        'SUPER_ADMIN',
        'SUPER ADMIN',
        'super administrador',
        'super_administracion',
        'superadministrador',
        'super_administrador'
      ];
    }

    function isAdminOrSuper() {
      return isAdmin() || isSuperAdmin();
    }

    function isManager() {
      return activeUser() && role() in ['gerencia', 'gerente', 'Gerencia', 'Gerente'];
    }

    function isChiefLogistics() {
      return activeUser() && role() in ['jefe_logistica', 'jefe_logistico', 'Jefe logística', 'Jefe logistica'];
    }

    function canSeeAll() {
      return isAdminOrSuper() || isManager() || isChiefLogistics();
    }

    function canManageUsers() {
      return isAdminOrSuper() || isManager();
    }

    function validCasePayload() {
      return request.resource.data.keys().hasAny([
        'currentProcess',
        'assignedRole',
        'assignedUid',
        'assignedTo',
        'assignedName',
        'assignedUsers',
        'assignedUserIds',
        'visibleRoles',
        'targetRoles',
        'status',
        'createdAt',
        'updatedAt',
        'requirementType',
        'noDelivery',
        'noDeliveryStatus',
        'returnToCash',
        'history',
        'flowTrace',
        'requirements',
        'openRequirement',
        'closedAt',
        'closedBy',
        'closedByName',
        'lastAction',
        'lastActionBy',
        'lastActionByName',
        'documentFlow',
        'checklist'
      ]);
    }

    function validUserPayload() {
      return request.resource.data.name is string
        && request.resource.data.email is string
        && request.resource.data.role is string
        && request.resource.data.isActive is bool;
    }

    function validRequirementPayload() {
      return request.resource.data.keys().hasAny([
        'caseId',
        'targetRole',
        'targetRoles',
        'visibleRoles',
        'sourceRole',
        'sourceProcess',
        'status',
        'type',
        'requirementType',
        'category',
        'createdBy',
        'createdAt',
        'updatedAt',
        'detail',
        'description',
        'assignedUid',
        'assignedTo'
      ]);
    }

    function validReceptionPayload() {
      return request.resource.data.keys().hasAny([
        'documentNumber',
        'supplier',
        'receiptType',
        'conformity',
        'status',
        'support',
        'closureEvidence',
        'finalDecisionStatus',
        'createdAt',
        'updatedAt'
      ]);
    }

    function validReportPayload() {
      return request.resource.data.keys().hasAny([
        'title',
        'category',
        'sourceModule',
        'sourceId',
        'sourceReference',
        'status',
        'severity',
        'description',
        'detail',
        'createdAt',
        'updatedAt'
      ]);
    }

    match /users/{userId} {
      allow read: if activeUser();
      allow create: if canManageUsers() && validUserPayload();
      allow update: if canManageUsers() && validUserPayload();
      allow delete: if isAdminOrSuper();
    }

    match /cases/{caseId} {
      allow read: if activeUser();
      allow create: if activeUser() && validCasePayload();
      allow update: if activeUser() && validCasePayload();
      allow delete: if isAdminOrSuper();
    }

    match /case_events/{eventId} {
      allow read: if activeUser();
      allow create: if activeUser();
      allow update: if false;
      allow delete: if isAdminOrSuper();
    }

    match /requirements/{requirementId} {
      allow read: if activeUser();
      allow create: if activeUser() && validRequirementPayload();
      allow update: if activeUser() && validRequirementPayload();
      allow delete: if isAdminOrSuper();
    }

    match /evidences/{evidenceId} {
      allow read: if activeUser();
      allow create: if activeUser();
      allow update: if false;
      allow delete: if isAdminOrSuper();
    }

    match /kpis/{kpiId} {
      allow read: if canSeeAll();
      allow create, update, delete: if isAdminOrSuper();
    }

    match /siesa_exports/{exportId} {
      allow read: if activeUser();
      allow create: if activeUser();
      allow update, delete: if isAdminOrSuper();
    }

    match /proyectos_pedidos/{projectId} {
      allow read: if activeUser();
      allow create: if activeUser();
      allow update: if activeUser();
      allow delete: if isAdminOrSuper();
    }

    match /recepciones_mercancia/{receptionId} {
      allow read: if activeUser();
      allow create: if activeUser() && validReceptionPayload();
      allow update: if activeUser() && validReceptionPayload();
      allow delete: if isSuperAdmin();
    }

    match /reportes_novedad/{reportId} {
      allow read: if activeUser();
      allow create: if activeUser() && validReportPayload();
      allow update: if activeUser() && validReportPayload();
      allow delete: if isSuperAdmin();
    }

    match /users_deleted_log/{logId} {
      allow read, create: if isAdminOrSuper();
      allow update, delete: if false;
    }

    match /system_config/{configId} {
      allow read: if activeUser();
      allow create, update, delete: if isAdminOrSuper();
    }

    match /{document=**} {
      allow read: if false;
      allow write: if false;
      allow delete: if isAdminOrSuper();
    }
  }
}
